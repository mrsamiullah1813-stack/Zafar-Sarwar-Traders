# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE CONFIGURATION:
# The application accepts both VITE_ prefixed and standard environment variable names:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Alternative variable names supported across Hostinger, Vercel, and Docker:
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"

# Server-Side Supabase Service Role Key (Optional for bypass of RLS on backend proxy):
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

